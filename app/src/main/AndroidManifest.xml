<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RozgarConnector"
        tools:targetApi="31">

        <!-- Splash Activity -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.RozgarConnector"> <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        </activity>

        <!-- Auth Activities with Keyboard Optimization -->
        <activity android:name=".ui.auth.LoginActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.auth.ForgotPasswordActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.auth.ResetPasswordActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.auth.RegisterActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.auth.PendingApprovalActivity" android:exported="false" />
        
        <!-- Home Activities -->
        <activity android:name=".ui.home.SeekerHomeActivity" android:exported="false" android:windowSoftInputMode="adjustPan"/>
        <activity android:name=".ui.home.ProviderHomeActivity" android:exported="false" android:windowSoftInputMode="adjustPan"/>
        
        <!-- Role & Profile Activities -->
        <activity android:name=".ui.role.RoleSelectionActivity" android:exported="false" />
        <activity android:name=".ui.profile.EducatedWorkerProfileActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.profile.UneducatedWorkerProfileActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        
        <!-- Job & Applications -->
        <activity android:name=".ui.job.JobPostActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.job.JobDetailActivity" android:exported="false" />
        <activity android:name=".ui.seeker.ViewApplicationsActivity" android:exported="false" />
        <activity android:name=".ui.worker.WorkerDetailActivity" android:exported="false" />
        
        <!-- Messaging & Chat -->
        <activity android:name=".ui.messaging.ChatActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>

        <activity android:name=".ui.settings.SettingsActivity" android:exported="false" />

        <!-- Help & Admin -->
        <activity android:name=".ui.help.HelpCenterActivity" android:exported="false" />
        <activity android:name=".ui.help.ChatWithAdminActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.admin.AdminDashboardActivity" android:windowSoftInputMode="adjustResize"/>

        <!-- Service -->
        <service
            android:name=".services.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>