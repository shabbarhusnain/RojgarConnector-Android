<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rozgar\nConnector"
            android:textAlignment="center"
            android:textColor="@color/primary_green"
            android:textSize="@dimen/splash_title_size"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="Official Service Portal"
            android:textColor="@color/dark_grey"
            android:letterSpacing="0.1"
            android:textSize="@dimen/text_size_normal" />

        <ProgressBar
            android:layout_width="@dimen/spacing_xl"
            android:layout_height="@dimen/spacing_xl"
            android:layout_marginTop="@dimen/icon_medium"
            android:indeterminateTint="@color/primary_green"/>

    </LinearLayout>

</RelativeLayout>
