<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Professional Toolbar with DP -->
    <RelativeLayout
        android:id="@+id/chatToolbarArea"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/header_gradient_curved"
        android:paddingHorizontal="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivReceiverDp"
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_toEndOf="@id/btnBack"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="@color/white"
            app:strokeWidth="1dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_toEndOf="@id/ivReceiverDp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReceiverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiverSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Service Seeker"
                android:textColor="#E0E0E0"
                android:textSize="@dimen/text_size_sm" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Chat Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        android:clipToPadding="false"
        android:padding="@dimen/spacing_md"
        app:layout_constraintBottom_toTopOf="@+id/llInputArea"
        app:layout_constraintTop_toBottomOf="@id/chatToolbarArea" />

    <!-- Read Only Banner -->
    <TextView
        android:id="@+id/tvReadOnlyBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF3E0"
        android:gravity="center"
        android:padding="12dp"
        android:text="Contract finished. Chat is read-only."
        android:textColor="#E65100"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Message Input Area -->
    <LinearLayout
        android:id="@+id/llInputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="@dimen/spacing_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_sm"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/edittext_border"
            android:backgroundTint="#C9E0B1"
            android:hint="@string/type_message_hint"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:padding="@dimen/spacing_md"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="@dimen/icon_xlarge"
            android:layout_height="@dimen/icon_xlarge"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/spacing_md"
            android:scaleType="centerInside"
            android:src="@drawable/ic_send"
            app:tint="@color/primary_green" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>