<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="@dimen/auth_content_padding">

    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="@dimen/icon_large"
        android:layout_height="@dimen/btn_height_small"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="@dimen/spacing_2xl"
        android:layout_marginEnd="@dimen/icon_medium"
        android:padding="@dimen/spacing_xs"
        android:src="@drawable/ic_menu"
        app:tint="@color/black" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Your Role"
                android:textColor="@color/primary_green"
                android:textSize="@dimen/text_size_2xl"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Are you looking to hire or to work?"
                android:textColor="@color/grey"
                android:textSize="@dimen/text_size_normal"
                android:layout_marginBottom="@dimen/icon_large"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSeeker"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_button_height"
                android:layout_marginBottom="@dimen/spacing_default"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/primary_green"
                app:strokeColor="@color/brand_yellow"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Service Seeker"
                    android:background="@color/primary_green"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/role_card_text_size"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProvider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_button_height"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"

                app:strokeColor="@color/brand_yellow"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Service Provider"
                    android:textAlignment="center"
                    android:background="@color/brand_yellow"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/role_card_text_size"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/llProviderType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/icon_medium"
                android:background="@drawable/edittext_border"
                android:orientation="vertical"
                android:padding="@dimen/spacing_default"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:text="Select Worker Type:"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioGroupProviderType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/radioEducated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/primary_green"
                        android:padding="@dimen/spacing_sm"
                        android:text="Educated (Degree/Diploma Holder)" />

                    <RadioButton
                        android:id="@+id/radioUneducated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/primary_green"
                        android:padding="@dimen/spacing_sm"
                        android:text="Uneducated (Skilled Labor/Manual)" />
                </RadioGroup>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnConfirmRole"
        android:layout_width="match_parent"
        android:layout_height="@dimen/menu_action_height"
        android:layout_alignParentBottom="true"
        android:background="@drawable/docglass_bg"
        android:text="Confirm and Continue"
        android:textSize="@dimen/text_size_lg"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@null"
        app:cornerRadius="12dp" />

</RelativeLayout>
