<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- TikTok Style Header -->
    <RelativeLayout
        android:id="@+id/settingsHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/icon_xlarge"
        android:paddingHorizontal="@dimen/spacing_default"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_large"
            android:layout_height="@dimen/icon_large"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/black" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Account information"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Main Account Info List -->
    <LinearLayout
        android:id="@+id/mainMenuLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsHeader">

        <!-- Phone Row -->
        <RelativeLayout
            android:id="@+id/btnPhoneRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/icon_xlarge"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="@dimen/spacing_default"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Phone number"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_normal" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvCurrentPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+92 *******00"
                    android:textColor="#8A8A8E"
                    android:textSize="@dimen/text_size_normal" />
                <ImageView
                    android:layout_width="@dimen/spacing_default"
                    android:layout_height="@dimen/spacing_default"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:rotation="180"
                    android:src="@drawable/ic_back"
                    app:tint="#C7C7CC" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Password Row (Forgot/Change Password) -->
        <RelativeLayout
            android:id="@+id/btnPasswordRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/icon_xlarge"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="@dimen/spacing_default"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Password"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_normal" />
            <ImageView
                android:layout_width="@dimen/spacing_default"
                android:layout_height="@dimen/spacing_default"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:rotation="180"
                android:src="@drawable/ic_back"
                app:tint="#C7C7CC" />
        </RelativeLayout>

        <!-- Verification Status Row (Read-only) -->
        <RelativeLayout
            android:id="@+id/btnStatusRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/icon_xlarge"
            android:paddingHorizontal="@dimen/spacing_default">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Verification Status"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_normal" />
            <TextView
                android:id="@+id/tvVerificationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Verified"
                android:textColor="@color/primary_green"
                android:textSize="@dimen/text_size_normal"
                android:textStyle="bold" />
        </RelativeLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Delete Account Bottom Section -->
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F2F2F7" />
        <RelativeLayout
            android:id="@+id/btnDeleteAccountRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/icon_xlarge"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="@dimen/spacing_default"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Deactivate or delete account"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_normal" />
            <ImageView
                android:layout_width="@dimen/spacing_default"
                android:layout_height="@dimen/spacing_default"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:rotation="180"
                android:src="@drawable/ic_back"
                app:tint="#C7C7CC" />
        </RelativeLayout>
    </LinearLayout>

    <!-- STEP CONTAINER (Dynamic Content) -->
    <FrameLayout
        android:id="@+id/stepContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>