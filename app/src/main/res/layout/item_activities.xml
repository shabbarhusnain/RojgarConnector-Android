<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="2dp"
    android:backgroundTint="#F1FBE3"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeColor="#FFFFFF"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Active Header Info (Work in Progress / Days Left) -->
        <LinearLayout
            android:id="@+id/llActiveInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvWorkInProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/work_in_progress"
                android:textColor="@color/primary_green"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDaysLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F6EAD8"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="2dp"
                android:text="@string/days_left"
                android:textColor="#E60000"
                android:textSize="@dimen/text_size_xs"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/btn_height_small"
                android:layout_height="@dimen/btn_height_small"
                android:layout_marginEnd="@dimen/spacing_md">

                <ImageView
                    android:id="@+id/ivNotificationIcon"
                    android:layout_width="@dimen/btn_height_small"
                    android:layout_height="@dimen/btn_height_small"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="#FAFAFB"
                    android:padding="@dimen/spacing_md"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/primary_green" />

                <!-- Red badge dot for unread notifications -->
                <View
                    android:id="@+id/redDot"
                    android:layout_width="@dimen/spacing_md"
                    android:layout_height="@dimen/spacing_md"
                    android:layout_gravity="top|end"
                    android:layout_margin="2dp"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="#FF0000"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNotificationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Update"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_normal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNotificationTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/just_now"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/text_size_xs" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/docglass_bg"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_xs"
                android:text="@string/pending"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_xs"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNotificationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:lineSpacingExtra="@dimen/spacing_xs"
            android:text="Message details go here..."
            android:textColor="#555555"
            android:textSize="@dimen/text_size_md" />

        <!-- Emergency & Action Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmergency"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="@string/sos"
                android:textColor="@color/red"
                android:visibility="visible"
                app:icon="@android:drawable/ic_menu_call"
                app:iconTint="@color/red" />

            <LinearLayout
                android:id="@+id/llActionArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel"
                    android:textColor="@color/red"
                    android:textSize="@dimen/text_size_sm"
                    app:icon="@android:drawable/ic_menu_close_clear_cancel"
                    app:iconSize="16dp"
                    app:iconTint="@color/red" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnComplete"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:background="@drawable/glass_bg"
                    android:backgroundTint="@color/primary_green"
                    android:text="@string/finish_job"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_sm"
                    android:visibility="gone"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChat"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:background="@drawable/glass_bg"
                    android:backgroundTint="@color/primary_green"
                    android:text="@string/chat_btn"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_sm"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_messages"
                    app:iconSize="20dp"
                    app:iconTint="@color/white" />
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>