<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Why are you reporting this user?"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_normal"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spReportReason"
        android:layout_width="match_parent"
        android:layout_height="@dimen/icon_xlarge"
        android:layout_marginBottom="@dimen/spacing_default"
        android:background="@drawable/edit_text_background" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Provide more details for the Admin"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_normal"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etReportDescription"
        android:layout_width="match_parent"
        android:layout_height="@dimen/icon_2xlarge"
        android:background="@drawable/edit_text_background"
        android:gravity="top|start"
        android:hint="Explain what happened (minimum 10 characters)..."
        android:inputType="textMultiLine"
        android:padding="@dimen/spacing_md"
        android:textSize="@dimen/text_size_normal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="* False reports can lead to account suspension."
        android:textColor="@color/red"
        android:textSize="@dimen/text_size_xs"
        android:textStyle="italic" />

</LinearLayout>