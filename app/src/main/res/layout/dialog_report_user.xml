<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Why are you reporting this user?"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spReportReason"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/edit_text_background" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Provide more details for the Admin"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etReportDescription"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/edit_text_background"
        android:gravity="top|start"
        android:hint="Explain what happened (minimum 10 characters)..."
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="* False reports can lead to account suspension."
        android:textColor="@color/red"
        android:textSize="11sp"
        android:textStyle="italic" />

</LinearLayout>