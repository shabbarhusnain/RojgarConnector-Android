<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    android:layout_margin="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What do you want to post?"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"/>

        <!-- Choice 1: Educated Job -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChoiceEducated"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="Professional Job\n(Educated Workers)"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/primary_green"
            app:strokeColor="@color/primary_green"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_educated_worker"
            app:iconGravity="textStart"
            android:layout_marginBottom="12dp"/>

        <!-- Choice 2: Manual Work -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChoiceManual"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="Manual Work / Task\n(Skilled Workers)"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:backgroundTint="@color/primary_green"
            android:textColor="@color/white"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_uneducated_worker"
            app:iconGravity="textStart"
            app:iconTint="@color/white"/>

        <Button
            android:id="@+id/btnCancelChoice"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Not Now"
            android:textColor="@color/grey" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>