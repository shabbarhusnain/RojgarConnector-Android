<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_default"
    android:layout_marginVertical="@dimen/spacing_sm"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeColor="#F9FAF9"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F1FBE3"
        android:orientation="vertical"
        android:padding="@dimen/spacing_default">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvJobTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Senior Accountant"
                android:textColor="#1A1C1E"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/tvSalaryTag"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvSalaryTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_salary_badge"
                android:backgroundTint="#84D12A"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_xs"
                android:text="Rs. 45,000"
                android:textColor="#FDFDFD"
                android:textSize="@dimen/text_size_md"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tvWorkplace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Alpha Solutions • Office"
            android:textColor="#5F6368"
            android:textSize="@dimen/text_size_normal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/spacing_md"
            android:background="#52760A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/spacing_default"
                android:layout_height="@dimen/spacing_default"
                android:src="@drawable/ic_location"
                app:tint="#84D12A" />

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Faisalabad, Punjab"
                android:textColor="#5F6368"
                android:textSize="@dimen/text_size_sm" />

            <TextView
                android:id="@+id/tvTimeAgo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="2 hours ago"
                android:textColor="#9AA0A6"
                android:textSize="@dimen/text_size_sm" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
