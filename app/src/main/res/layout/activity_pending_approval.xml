<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:padding="@dimen/spacing_2xl"
    tools:context=".ui.auth.PendingApprovalActivity">

    <!-- TOP MENU -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- PENDING VIEW -->
        <LinearLayout
            android:id="@+id/llPendingView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:visibility="visible"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/icon_2xlarge"
                android:layout_height="@dimen/icon_2xlarge"
                android:src="@drawable/ic_pending"
                android:layout_marginBottom="@dimen/icon_medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Approval Pending"
                android:textColor="@color/primary_green"
                android:textSize="@dimen/text_size_2xl"
                android:textStyle="bold" 
                android:layout_marginBottom="@dimen/spacing_default"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your documents are under review. You will be notified once your account is approved. This usually takes 24-48 hours."
                android:textAlignment="center"
                android:textColor="@color/dark_grey"
                android:textSize="@dimen/text_size_medium" />
        </LinearLayout>

        <!-- REJECTED VIEW (Hidden by default) -->
        <LinearLayout
            android:id="@+id/llRejectedView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:visibility="gone"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/icon_2xlarge"
                android:layout_height="@dimen/icon_2xlarge"
                android:src="@drawable/ic_failed"
                app:tint="@android:color/holo_red_dark"
                android:layout_marginBottom="@dimen/spacing_default"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Rejected"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="@dimen/text_size_xl"
                android:textStyle="bold" 
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <TextView
                android:id="@+id/tvRejectionReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reason: Documents were blurred."
                android:textAlignment="center"
                android:textColor="@color/dark_grey"
                android:textStyle="italic"
                android:textSize="@dimen/text_size_medium"
                android:layout_marginBottom="@dimen/icon_medium"/>

            <Button
                android:id="@+id/btnReApply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary_green"
                android:text="Update Documents / Re-Apply"
                android:textColor="@color/white"
                android:layout_marginHorizontal="@dimen/spacing_lg"/>
        </LinearLayout>

         <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_bg"
            android:layout_marginTop="@dimen/spacing_2xl"
            android:text="Logout"/>

    </LinearLayout>
</RelativeLayout>