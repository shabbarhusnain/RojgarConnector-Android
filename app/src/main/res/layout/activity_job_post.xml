<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/header_gradient_curved"
            android:paddingHorizontal="16dp">
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />
            <TextView
                android:id="@+id/tvTitleHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Post a New Job"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card 1: Job Title -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Basic Job Information"
                        android:textColor="@color/primary_green"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/etJobTitle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/toggle_bg_outline"
                        android:hint="Position Name (e.g. Sales Manager)"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp" />

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnUploadJobPhoto"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            app:cardCornerRadius="12dp"
                            app:strokeColor="#DCE6CC"
                            app:strokeWidth="1dp">
                            <ImageView
                                android:id="@+id/ivJobPoster"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_add_circle"
                                android:padding="24dp"
                                app:tint="@color/grey" />
                        </com.google.android.material.card.MaterialCardView>

                        <ImageView
                            android:id="@+id/ivRemovePhoto"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/toggle_selected_bg"
                            android:padding="4dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:visibility="gone"
                            app:tint="@color/red" />
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Company Info -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Employer / Company Information"
                        android:textColor="@color/primary_green"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/etWorkplaceName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/toggle_bg_outline"
                        android:hint="Company Name"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/etCompanyIntro"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/toggle_bg_outline"
                        android:hint="Brief Company Introduction"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Requirements -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Job Description &amp; Requirements"
                        android:textColor="@color/primary_green"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/etJobDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/toggle_bg_outline"
                        android:gravity="top"
                        android:hint="Responsibilities (Key tasks)..."
                        android:minHeight="80dp"
                        android:padding="12dp"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/etQualifications"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/toggle_bg_outline"
                        android:hint="Qualification &amp; Experience needed..."
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: District & Location -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Work District &amp; Location"
                        android:textColor="@color/primary_green"
                        android:textStyle="bold" />
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select District"
                        android:textSize="12sp"
                        android:textColor="@color/grey"
                        android:layout_marginTop="8dp"/>
                    <Spinner
                        android:id="@+id/spinnerDistrict"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/toggle_bg_outline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Job Category"
                        android:textSize="12sp"
                        android:textColor="@color/grey"
                        android:layout_marginTop="12dp"/>
                    <Spinner
                        android:id="@+id/spinnerJobCategory"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/toggle_bg_outline" />
                    
                    <EditText
                        android:id="@+id/etWorkplaceAddress"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/toggle_bg_outline"
                        android:hint="Job Area / Full Address"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: Compensation -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Compensation &amp; Perks"
                        android:textColor="@color/primary_green"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/etPayAmount"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/toggle_bg_outline"
                        android:hint="Salary Range / Budget (PKR)"
                        android:inputType="number"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/etBenefits"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/toggle_bg_outline"
                        android:hint="Benefits (Medical, Transport, etc.)"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 6: Deadline -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deadline &amp; Conditions"
                        android:textColor="@color/primary_green"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/etLastDate"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/toggle_bg_outline"
                        android:focusable="false"
                        android:clickable="true"
                        android:hint="Select Last Date to Apply"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp" />
                    <CheckBox
                        android:id="@+id/cbIsNegotiable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Budget is Negotiable"
                        android:buttonTint="@color/primary_green" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnPublishJob"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/primary_green"
                android:text="PUBLISH JOB NOW"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>