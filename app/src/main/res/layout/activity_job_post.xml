<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/header_gradient_curved"
            app:title="@string/post_new_job"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Job Info -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/job_info"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etJobTitle"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="@string/job_title_hint"
                        android:background="@drawable/edittext_border"
                        android:paddingStart="12dp"
                        android:layout_marginBottom="12dp"
                        android:textSize="15sp"/>

                    <Spinner
                        android:id="@+id/spinnerWorkplaceType"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/edittext_border"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/workplace_location"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etWorkplaceName"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="@string/workplace_name_hint"
                        android:background="@drawable/edittext_border"
                        android:paddingStart="12dp"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etWorkplaceAddress"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="@string/full_address_hint"
                        android:background="@drawable/edittext_border"
                        android:paddingStart="12dp"
                        android:layout_marginBottom="12dp"/>

                    <Spinner
                        android:id="@+id/spinnerDistrict"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/edittext_border"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Worker Selection & Category -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/worker_category_header"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        android:layout_marginBottom="8dp"/>

                    <RadioGroup
                        android:id="@+id/rgWorkerType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <RadioButton android:id="@+id/rbEducated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/educated" android:checked="true" android:layout_marginEnd="16dp" android:buttonTint="@color/primary_green"/>
                        <RadioButton android:id="@+id/rbUneducated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/uneducated" android:buttonTint="@color/primary_green"/>
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_skill_category"
                        android:textColor="@color/grey"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/spinnerJobCategory"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/edittext_border"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Budget -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/budget_time"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <EditText
                            android:id="@+id/etPayAmount"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:hint="@string/amount_pkr_hint"
                            android:inputType="number"
                            android:background="@drawable/edittext_border"
                            android:paddingStart="12dp"
                            android:layout_marginEnd="6dp"/>

                        <Spinner
                            android:id="@+id/spinnerPayUnit"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:background="@drawable/edittext_border"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:weightSum="2">

                        <EditText
                            android:id="@+id/etDurationValue"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="0.8"
                            android:hint="@string/value_hint"
                            android:inputType="number"
                            android:background="@drawable/edittext_border"
                            android:paddingStart="12dp"
                            android:layout_marginEnd="6dp"/>

                        <Spinner
                            android:id="@+id/spinnerDurationUnit"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1.2"
                            android:background="@drawable/edittext_border"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Description -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <EditText
                        android:id="@+id/etJobDescription"
                        android:layout_width="match_parent"
                        android:layout_height="127dp"
                        android:gravity="top"
                        android:hint="@string/job_desc_hint"
                        android:padding="12dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnPostJob"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/publish_job"
                android:textStyle="bold"
                android:background="@drawable/glass_bg"
                app:cornerRadius="12dp"
                android:elevation="4dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>