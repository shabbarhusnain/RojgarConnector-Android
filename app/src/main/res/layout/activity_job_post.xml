<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/header_gradient_curved"
            app:title="@string/post_new_job"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Job Info -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="@dimen/spacing_default">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_default">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/job_info"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        android:layout_marginBottom="@dimen/spacing_md"/>

                    <EditText
                        android:id="@+id/etJobTitle"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_field_height"
                        android:hint="@string/job_title_hint"
                        android:background="@drawable/edittext_border"
                        android:paddingStart="@dimen/spacing_md"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:textSize="@dimen/text_size_normal"/>

                    <Spinner
                        android:id="@+id/spinnerWorkplaceType"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_field_height"
                        android:background="@drawable/edittext_border"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Worker Selection & Category -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="@dimen/spacing_default">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_default">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/worker_category_header"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        android:layout_marginBottom="@dimen/spacing_sm"/>

                    <RadioGroup
                        android:id="@+id/rgWorkerType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/spacing_md">
                        <RadioButton android:id="@+id/rbEducated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/educated" android:checked="true" android:layout_marginEnd="@dimen/spacing_default" android:buttonTint="@color/primary_green"/>
                        <RadioButton android:id="@+id/rbUneducated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/uneducated" android:buttonTint="@color/primary_green"/>
                    </RadioGroup>

                    <Spinner
                        android:id="@+id/spinnerJobCategory"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_field_height"
                        android:background="@drawable/edittext_border"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Work Terms & Logistics -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="@dimen/spacing_default">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_default">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Work Terms &amp; Logistics"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        android:layout_marginBottom="@dimen/spacing_md"/>

                    <CheckBox
                        android:id="@+id/cbIsNegotiable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Price is Negotiable"
                        android:buttonTint="@color/primary_green"
                        android:minHeight="@dimen/icon_xlarge"/>

                    <CheckBox
                        android:id="@+id/cbVisitRequired"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Site Visit Required for Quote"
                        android:buttonTint="@color/primary_green"
                        android:minHeight="@dimen/icon_xlarge"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Who will provide the tools/equipment?"
                        android:textSize="@dimen/text_size_sm"
                        android:textColor="@color/grey"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:layout_marginBottom="@dimen/spacing_xs"/>
                    
                    <Spinner
                        android:id="@+id/spinnerToolsProvided"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_field_height"
                        android:background="@drawable/edittext_border"/>

                    <CheckBox
                        android:id="@+id/cbSafetyHazards"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="Potential Safety Hazards"
                        android:buttonTint="#F44336"
                        android:minHeight="@dimen/icon_xlarge"/>

                    <EditText
                        android:id="@+id/etHazardsDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Describe hazards..."
                        android:visibility="gone"
                        android:textSize="@dimen/text_size_normal"
                        android:background="@drawable/edittext_border"
                        android:padding="@dimen/spacing_md"
                        android:layout_marginTop="@dimen/spacing_xs"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Budget & Time -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="@dimen/spacing_default">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_default">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/budget_time"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        android:layout_marginBottom="@dimen/spacing_md"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payment Amount (PKR)"
                        android:textSize="@dimen/text_size_sm"
                        android:textColor="@color/grey"
                        android:layout_marginBottom="@dimen/spacing_xs"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <EditText
                            android:id="@+id/etPayAmount"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/input_field_height"
                            android:layout_weight="1.2"
                            android:hint="e.g. 500"
                            android:inputType="number"
                            android:background="@drawable/edittext_border"
                            android:paddingStart="@dimen/spacing_md"
                            android:layout_marginEnd="@dimen/spacing_sm"/>

                        <Spinner
                            android:id="@+id/spinnerPayUnit"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/input_field_height"
                            android:layout_weight="0.8"
                            android:background="@drawable/edittext_border"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expected Completion Time"
                        android:textSize="@dimen/text_size_sm"
                        android:textColor="@color/grey"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:layout_marginBottom="@dimen/spacing_xs"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <EditText
                            android:id="@+id/etDurationValue"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/input_field_height"
                            android:layout_weight="0.8"
                            android:hint="e.g. 2"
                            android:inputType="number"
                            android:background="@drawable/edittext_border"
                            android:paddingStart="@dimen/spacing_md"
                            android:layout_marginEnd="@dimen/spacing_sm"/>

                        <Spinner
                            android:id="@+id/spinnerDurationUnit"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/input_field_height"
                            android:layout_weight="1.2"
                            android:background="@drawable/edittext_border"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="@dimen/spacing_default">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_default">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/workplace_location"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        android:layout_marginBottom="@dimen/spacing_md"/>

                    <EditText
                        android:id="@+id/etWorkplaceName"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_field_height"
                        android:hint="@string/workplace_name_hint"
                        android:background="@drawable/edittext_border"
                        android:paddingStart="@dimen/spacing_md"
                        android:layout_marginBottom="@dimen/spacing_md"/>

                    <EditText
                        android:id="@+id/etWorkplaceAddress"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_field_height"
                        android:hint="@string/full_address_hint"
                        android:background="@drawable/edittext_border"
                        android:paddingStart="@dimen/spacing_md"
                        android:layout_marginBottom="@dimen/spacing_md"/>

                    <Spinner
                        android:id="@+id/spinnerDistrict"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_field_height"
                        android:background="@drawable/edittext_border"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Description -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="@dimen/icon_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_default">

                    <EditText
                        android:id="@+id/etJobDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/icon_2xlarge"
                        android:gravity="top"
                        android:hint="@string/job_desc_hint"
                        android:padding="@dimen/spacing_md"
                        android:textSize="@dimen/text_size_normal"
                        android:background="@drawable/edittext_border"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Commitment -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_default">
                <CheckBox
                    android:id="@+id/cbEthicalTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/primary_green"
                    android:minHeight="@dimen/icon_xlarge"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="I commit to safety and timely payment."
                    android:textSize="@dimen/text_size_sm"
                    android:textColor="@color/black"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnPostJob"
                android:layout_width="match_parent"
                android:layout_height="@dimen/icon_xlarge"
                android:text="@string/publish_job"
                android:textStyle="bold"
                android:background="@drawable/glass_bg"
                android:textColor="@color/white"
                app:cornerRadius="12dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>