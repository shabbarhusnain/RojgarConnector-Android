<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomActionArea">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header with Back and Report -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_default">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/icon_large"
                    android:layout_height="@dimen/icon_large"
                    android:src="@drawable/ic_back"
                    app:tint="@color/black" />

                <ImageView
                    android:id="@+id/btnReport"
                    android:layout_width="@dimen/icon_large"
                    android:layout_height="@dimen/icon_large"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/purple_700" />
            </RelativeLayout>

            <!-- Profile Info -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">
                
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgWorkerProfile"
                    android:layout_width="@dimen/icon_2xlarge"
                    android:layout_height="@dimen/icon_2xlarge"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile"
                    app:shapeAppearanceOverlay="@style/CircleImage" />

                <ImageView
                    android:id="@+id/imgVerifiedBadge"
                    android:layout_width="@dimen/spacing_2xl"
                    android:layout_height="@dimen/spacing_2xl"
                    android:layout_alignBottom="@id/imgWorkerProfile"
                    android:layout_alignEnd="@id/imgWorkerProfile"
                    android:src="@drawable/ic_notification"
                    android:visibility="gone"
                    app:tint="@color/primary_green" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvWorkerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="Worker Name"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_lg"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">
                
                <TextView
                    android:id="@+id/tvSkill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Professional Skill"
                    android:textColor="@color/primary_green" />

                <RatingBar
                    android:id="@+id/workerRatingBar"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:numStars="5"
                    android:progressTint="#FFD700"
                    android:rating="0" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_margin="@dimen/spacing_default"
                android:background="#EEEEEE" />

            <!-- Portfolio Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_default">

                <TextView
                    android:id="@+id/tvPortfolioTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:text="@string/portfolio"
                    android:textSize="@dimen/text_size_lg"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/experience_label"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:text="5 Years" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_work"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_default"
                    android:text="Professional description here..." />

                <!-- Education Section (Conditional) -->
                <LinearLayout
                    android:id="@+id/eduSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/education_details"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEdu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="BS Computer Science" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/degreeSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/degree_doc"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imgDegree"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:background="#F5F5F5"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM ACTION AREA -->
    <LinearLayout
        android:id="@+id/bottomActionArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="@dimen/spacing_sm"
        android:orientation="vertical"
        android:padding="@dimen/spacing_default">

        <!-- Standard Hiring Button (Loop Button) -->
        <Button
            android:id="@+id/btnHireNow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_large"
            android:background="@drawable/glass_bg"
            android:text="@string/hire_worker"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:visibility="visible" />

        <!-- Application Decision Buttons (New Fix) -->
        <LinearLayout
            android:id="@+id/llApplicationActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnDeclineApp"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height_large"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:background="@drawable/redglass"
                android:text="@string/decline"
                android:textColor="@color/white"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnAcceptApp"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height_large"
                android:layout_weight="1"
                android:background="@drawable/glass_bg"
                android:text="@string/accept_hire"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>