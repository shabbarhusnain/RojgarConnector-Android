<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Worker Profile"
            android:textColor="@color/primary_green"
            android:textSize="@dimen/text_size_2xl"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_2xl"
            android:text="Set up your professional skill profile"
            android:textColor="@color/dark_grey"
            android:textSize="@dimen/text_size_medium" />

        <!-- PRIMARY SKILL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="What is your primary skill?"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerSkill"
            android:layout_width="match_parent"
            android:layout_height="@dimen/icon_xlarge"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="@drawable/edit_text_background" />

        <!-- EXPERIENCE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="Years of Experience"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etExperienceYears"
            android:layout_width="match_parent"
            android:layout_height="@dimen/icon_xlarge"
            android:layout_marginBottom="@dimen/spacing_default"
            android:background="@drawable/edit_text_background"
            android:hint="e.g. 5"
            android:inputType="number"
            android:paddingHorizontal="@dimen/spacing_default" />

        <!-- TOOLS / EQUIPMENT (Added for better context) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="Do you have your own tools/equipment?"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_default"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbToolsYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes"
                android:buttonTint="@color/primary_green"
                android:paddingEnd="24dp"/>
            <RadioButton
                android:id="@+id/rbToolsNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No"
                android:buttonTint="@color/primary_green"/>
        </RadioGroup>

        <!-- DESCRIPTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="Professional Bio / Description"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfessionalDescription"
            android:layout_width="match_parent"
            android:layout_height="@dimen/icon_2xlarge"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:background="@drawable/edit_text_background"
            android:gravity="top"
            android:hint="Tell seekers why they should hire you..."
            android:inputType="textMultiLine"
            android:padding="@dimen/spacing_default" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_2xl"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp">

            <CheckBox
                android:id="@+id/cbTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_md"
                android:text="I guarantee that my details are accurate and I will follow platform rules."
                android:textColor="#555555"
                android:textSize="@dimen/text_size_md" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_large"
            android:backgroundTint="@color/primary_green"
            android:text="FINISH &amp; SAVE"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_medium"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>