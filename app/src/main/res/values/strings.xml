    <!-- FAQ Q&A - Account -->
    <string name="faq_q1">How to register on Rozgar Connector?</string>
    <string name="faq_a1">Click \'Register\' on the login screen, enter your name, CNIC, phone number, and choose your role (Seeker or Provider) to create an account.</string>
    <string name="faq_q2">Can I change my role after registration?</string>
    <string name="faq_a2">Currently, roles are fixed at registration. If you need to switch, please contact our support agent for assistance.</string>
    <string name="faq_q3">Is my CNIC data safe?</string>
    <string name="faq_a3">Yes, your CNIC and personal documents are encrypted and only used for identity verification to ensure a safe community.</string>
    <string name="faq_q4">How to update my profile details?</string>
    <string name="faq_a4">Go to the \'Profile\' tab, where you can view and edit your basic info, education, and skills.</string>

    <!-- FAQ Q&A - Seeker -->
    <string name="faq_q5">How do I post a new job?</string>
    <string name="faq_a5">As a Seeker, go to Home and click the \'+\' or \'Post Job\' button. Fill in the title, location, budget, and description to publish it.</string>
    <string name="faq_q6">How can I see who applied for my job?</string>
    <string name="faq_a6">Go to the \'Activities\' tab and select \'Applications\'. You will see a list of workers who applied for your posted jobs.</string>
    <string name="faq_q7">How do I hire a specific worker?</string>
    <string name="faq_a7">Find a worker on the Home screen or in your applications, view their profile, and click \'Hire This Worker\' to send an offer.</string>
    <string name="faq_q8">Can I cancel a job post?</string>
    <string name="faq_a8">Yes, you can cancel your job post from the Activities tab if no contract has been started yet.</string>

    <!-- FAQ Q&A - Provider -->
    <string name="faq_q9">How do I find available jobs?</string>
    <string name="faq_a9">As a Provider, the Home screen shows all available jobs. You can search by title or filter by your skills.</string>
    <string name="faq_q10">How many jobs can I apply for?</string>
    <string name="faq_a10">There is no limit! You can apply for as many jobs as match your expertise to increase your chances of getting hired.</string>
    <string name="faq_q11">How do I know if I am hired?</string>
    <string name="faq_a11">You will receive a notification in the \'Activities\' tab under \'Offers\'. You can then \'Accept\' to start the work.</string>
    <string name="faq_q12">What is an Educated vs Uneducated worker?</string>
    <string name="faq_a12">Educated workers provide services like teaching or office work. Uneducated workers provide manual skills like plumbing or masonry.</string>

    <!-- FAQ Q&A - Safety -->
    <string name="faq_q13">What is the SOS button?</string>
    <string name="faq_a13">The SOS button is an emergency feature. Clicking it will dial 15 immediately if you feel unsafe during a job.</string>
    <string name="faq_q14">How are workers verified?</string>
    <string name="faq_a14">Every worker must upload their CNIC and documents. Our team manually verifies these details before approving their profile.</string>
    <string name="faq_q15">How to report a fake user?</string>
    <string name="faq_a15">You can report any suspicious activity by clicking \'Chat with Agent\' in the Menu and providing details.</string>
    <string name="faq_q16">Is my location shared with everyone?</string>
    <string name="faq_a16">Your general city is visible, but your exact address is only shared with the person you are officially working with.</string>

    <!-- FAQ Q&A - Completion -->
    <string name="faq_q17">How do I mark a job as finished?</string>
    <string name="faq_a17">Once work is done, go to the active job in the \'Activities\' tab and click \'Finish Job\'. Both parties must confirm completion.</string>
    <string name="faq_q18">How do payments work?</string>
    <string name="faq_a18">Currently, payments are handled directly between the seeker and worker. Please ensure payment is settled before marking \'Finish\'.</string>
    <string name="faq_q19">Why should I rate the other person?</string>
    <string name="faq_a19">Ratings help build trust. High-rated workers get more jobs, and good seekers attract better workers.</string>
    <string name="faq_q20">Where can I see my job history?</string>
    <string name="faq_a20">All your finished and cancelled jobs are stored in the \'History\' tab within the Activities section.</string>

